# DHARAWATCH Environment Configuration
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# ============================================================
# GOOGLE EARTH ENGINE (Required for satellite analysis)
# ============================================================
# Get these from: Google Cloud Console → IAM → Service Accounts
# Create a service account with Earth Engine access, then create a key
EARTH_ENGINE_PROJECT_ID=your-gcp-project-id
EARTH_ENGINE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Private key must have \n for newlines (paste the entire key including BEGIN/END lines)
EARTH_ENGINE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Alternative: Place ee-key.json in project root instead of the above three vars

# ============================================================
# GOOGLE MAPS PLATFORM (Required for Mission Planner routing & Places)
# ============================================================
# Get from: Google Cloud Console → APIs & Services → Credentials
# Enable these APIs: Maps JavaScript API, Places API (New), Directions API
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ============================================================
# AI / GEMINI (Optional - for AI vision analysis)
# ============================================================
# Get from: https://aistudio.google.com/app/apikey
# If not set, deterministic fallback analysis is used.
# Watershed page: without a key the "AI BRIEF" section shows AI BRIEF UNAVAILABLE; everything else still works.
AI_API_KEY=your-gemini-api-key
# Optional: force a specific Gemini model. If unset, the server asks the API which
# "gemini-*-flash" models this key can use and picks the newest (retired models are skipped automatically).
# AI_MODEL=gemini-x.y-flash

# ============================================================
# SERVER CONFIGURATION (Optional)
# ============================================================
# Port for backend API server (default: 3001)
PORT=3001
# Optional (dev only): point the Vite /api proxy at a backend on another port,
# e.g. API_TARGET=http://localhost:3011 npx vite --port 5190
# API_TARGET=http://localhost:3001

# Detection provider: earth-engine (default) or demo
DETECT_PROVIDER=earth-engine

# Max GeoTIFF upload size in MB (default: 100)
MAX_GEOTIFF_UPLOAD_MB=100

# Field data directory (default: ./server-data/field)
# FIELD_DATA_DIR=/path/to/field/data

# ============================================================
# DEVELOPMENT OVERRIDES (Optional)
# ============================================================
# Set to true to enable verbose logging
# DEBUG=true

# Force fallback mode for AI (bypass API calls)
# FORCE_AI_FALLBACK=false